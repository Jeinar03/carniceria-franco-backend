# ─────────────────────────────────────────────────────────────
#  Plantilla de .env para PRODUCCIÓN (Hostinger)
#  Copia este archivo a  .env  en el servidor y rellena los valores.
#  NO se sube a git (el .env real está en .gitignore).
# ─────────────────────────────────────────────────────────────

APP_NAME="Carniceria Franco"
APP_ENV=production
APP_KEY=                      # generar en el server con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://carniceriafrancoadmin.shop

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Base de datos (crear en hPanel → Bases de datos → MySQL) ──
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_carniceria       # el nombre EXACTO que da hPanel
DB_USERNAME=uXXXXXXXX_carniceria       # el usuario EXACTO que da hPanel
DB_PASSWORD=                            # la contraseña que pusiste en hPanel

# ── Frontend permitido para CORS (la tienda Angular) ──
FRONTEND_URL=https://tienda.carniceriafrancoadmin.shop

# ── Sesión / caché / colas (shared hosting: valores simples) ──
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

# ── Correo (para notificaciones de pedido). Ajustar con el
#    buzón que crees en hPanel → Emails ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@carniceriafrancoadmin.shop
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@carniceriafrancoadmin.shop
MAIL_FROM_NAME="Carniceria Franco"

# ── MercadoPago (opcional; también se puede configurar desde
#    el panel admin → Sistema → Mercado Pago) ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=true
